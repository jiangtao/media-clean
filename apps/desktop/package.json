{
  "name": "media-clean-desktop",
  "version": "0.0.2",
  "private": true,
  "description": "Electron desktop shell for the Media Clean local workbench",
  "main": "main.cjs",
  "scripts": {
    "renderer:dev": "vite --config vite.config.mjs --host 127.0.0.1 --port 5178",
    "renderer:build": "vite build --config vite.config.mjs",
    "dev": "npm run renderer:build && electron .",
    "smoke": "npm run renderer:build && cross-env MC_DESKTOP_SMOKE=1 electron .",
    "build": "npm run renderer:build && node ../../scripts/desktop/verify-desktop-smoke.mjs --static-only",
    "package:smoke": "npm run renderer:build && node ../../scripts/desktop/verify-desktop-smoke.mjs --package-no-server",
    "package:mac": "npm run renderer:build && node ../../scripts/desktop/build-release.mjs",
    "package:win": "npm run renderer:build && node ../../scripts/desktop/build-windows-release.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "less": "^4.6.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hotkeys-hook": "^5.3.2",
    "tailwind-merge": "^3.6.0"
  }
}
