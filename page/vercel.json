{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download/media-clean-desktop-macos-arm64.dmg",
      "destination": "https://github.com/jiangtao/media-clean/releases/download/desktop-latest/media-clean-desktop-macos-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/download/media-clean-desktop-windows-x64.zip",
      "destination": "https://github.com/jiangtao/media-clean/releases/download/desktop-latest/media-clean-desktop-windows-x64.zip",
      "permanent": false
    },
    {
      "source": "/download/media-clean-desktop-latest.sha256",
      "destination": "https://github.com/jiangtao/media-clean/releases/download/desktop-latest/media-clean-desktop-latest.sha256",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/download/android-latest.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"android-latest.apk\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        }
      ]
    },
    {
      "source": "/promo-video-60fps.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/apps/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/resources/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
